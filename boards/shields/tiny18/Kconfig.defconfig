if SHIELD_TINY18_R

config ZMK_KEYBOARD_NAME
    default "tiny18"

config ZMK_BLE
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_TINY18_R || SHIELD_TINY18_L


config ZMK_SPLIT
    default y

config INPUT
    default y

config ZMK_POINTING
    default y


config RGBLED_WIDGET_BATTERY_LEVEL_HIGH
    default 30

config RGBLED_WIDGET_BATTERY_LEVEL_CRITICAL
    default 10

endif

# LVGL values follow corne, which drives a 128x32 SSD1306. This panel is
# 128x64, so treat them as a starting point rather than tuned numbers.
if SHIELD_TINY18_OLED_SPI && LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif
